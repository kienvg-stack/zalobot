# Copy file này thành .env rồi điền vào

# Token bot lấy từ https://bot.zaloplatforms.com (dạng 123456789:abcxyz...)
ZALO_BOT_TOKEN=

# Key Gemini free lấy từ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên bot, phải trùng tên bot đặt trên Zalo (mọi người tag "@KienVG" để hỏi)
BOT_NAME=KienVG

# Model Gemini (gói free: 500 câu/ngày)
GEMINI_MODEL=gemini-3.5-flash-lite

# Nhóm nhận câu trả lời khi nhắn "gửi nhóm" trong chat riêng (dùng khi bot chưa thấy người đó tag trong nhóm nào)
DEFAULT_GROUP_ID=

# Số lượt hỏi-đáp gần nhất bot nhớ cho mỗi nhóm
HISTORY_TURNS=50

# 1 = cho phép tra Google khi cần thông tin mới (hết lượt free thì tự trả lời không search)
ENABLE_WEB_SEARCH=1

# Trả lời bằng giọng nói (chat riêng): link công khai tới bot (domain Dokploy, cổng 8080)
PUBLIC_URL=
# 1 = gửi kèm sticker Zapy hợp ngữ cảnh, 0 = tắt
ENABLE_STICKERS=1
